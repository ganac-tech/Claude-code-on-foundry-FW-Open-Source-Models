# Copy to .env and fill in. Do NOT commit .env.
#
# Both values come from the Microsoft Foundry portal -> Project settings.

# Foundry resource endpoint. Paste whatever the portal shows — the scheme, path,
# and port are stripped for you, so all of these work:
#   https://my-resource.services.ai.azure.com/api/projects/my-project
#   https://my-resource.services.ai.azure.com
#   my-resource.services.ai.azure.com
FOUNDRY_HOST=<resource>.services.ai.azure.com

# Azure API key for the Foundry project.
# Must be an Azure key — a Fireworks key (fw_...) or Fire Pass key (fpk_...)
# will not authenticate against Foundry.
AZURE_API_KEY=<your-azure-api-key>

# The Foundry deployment name for GLM 5.2. Only change this if your deployment
# was named something other than the default. Must match bodyMutation in
# aigw-foundry.yaml.
FOUNDRY_MODEL=FW-GLM-5.2

# OPTIONAL. Claude Code doesn't recognize FW-GLM-5.2, so it warns once and then
# assumes a 200k context window. That's safe but makes it auto-compact earlier
# than necessary. Set this to the deployment's real window to silence the warning.
# Check it in the Foundry portal or the Fireworks model library — don't guess.
# GLM_CONTEXT_TOKENS=200000

# Cache-routing key sent upstream on every request (Claude Code doesn't set one).
# Measured: same key -> 100% warm-prefix cache hit, different key -> 0%, so this
# reaches Fireworks through Foundry and partitions the prompt cache.
#
# Keep ONE key for the whole fleet. Every Claude Code user sends the same ~15k
# system prompt; a per-user key would split that shared prefix into one entry
# per user and LOWER the hit rate. Use per-user keys only when users have
# genuinely different long prefixes.
CACHE_KEY=paypal-claude-code
